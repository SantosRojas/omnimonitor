# ──────────────────────────────────────────────────────────────
#  Configuración del Bridge OMNI-PDMS
# ──────────────────────────────────────────────────────────────
# Este archivo define los valores por defecto para el bridge
# (pasarela serial → WebSocket). Los valores aquí definidos
# pueden ser sobrescritos por variables de entorno del sistema
# y por argumentos de línea de comandos.
#
# Precedencia (de menor a mayor prioridad):
#   Valores por defecto → .env → variables de entorno → CLI
#
# Para usar este archivo, cópielo como .env en este mismo
# directorio y ajuste los valores según su instalación.
# ──────────────────────────────────────────────────────────────

# Puerto serial donde está conectado el dispositivo OMNI.
# Ejemplos: COM1 (Windows), /dev/ttyUSB0 (Linux), /dev/cu.usbserial (macOS)
BRIDGE_PORT=COM1

# Velocidad de baudios para la comunicación serial.
# Valores típicos: 9600, 19200, 38400, 57600, 115200
BRIDGE_BAUD=115200

# URL del servidor WebSocket al que el bridge enviará los datos.
# Ejemplo: ws://host:9001/ws/bridge
BRIDGE_WS_URL=ws://localhost:9001/ws/bridge

# ═══════════════════════════════════════════════════════════
#  Filtro de señales.
#  Solo las señales listadas en CAPTURE_NAMES se envían como
#  telemetría (Readings) al servidor. CAPTURE_METADATA_NAMES
#  se extraen para TherapySetup pero nunca se persisten.
#
#  Si una variable está vacía o ausente, se usan los valores
#  por defecto del código.
# ═══════════════════════════════════════════════════════════
CAPTURE_NAMES=c_press_ep_act,c_pump_bs_bl_flow_act,c_pump_fs_mid_flow_act,d_renal_dose_act,c_acc_therapy_time_act,c_net_rem_flow_act,c_acc_net_rem_vol_act,c_press_ap_act,c_press_vp_act,c_press_fp_act,c_press_tmp_act
CAPTURE_METADATA_NAMES=d_serial_number_to_odi,g_patient_id_str,g_therapy_mode_set,g_anticoag_mode_set,d_kit_type_str,g_patient_data_weight_set

# ═══════════════════════════════════════════════════════════
#  Configuración de Protocolo OMNI-ODI.
#  Solo modificar si tiene los conocimientos necesarios.
# ═══════════════════════════════════════════════════════════

# Intervalo entre ciclos de lectura serial en milisegundos.
# Controla cada cuánto se lee el puerto serial. El mínimo
# práctico es 1000 (1 s) por diseño del protocolo OMNI-ODI.
# Valor por defecto: 1000 (1s). Setear a 0 elimina la pausa.
BRIDGE_CYCLE_INTERVAL=1000

# Dirección de origen (aplicación bridge) en el bus OMNI-ODI.
# Rango típico: 1–254. Por defecto: 11
BRIDGE_SRC_ADDR=11

# Dirección de destino (dispositivo) en el bus OMNI-ODI.
# Rango típico: 1–254. Por defecto: 1
BRIDGE_DST_ADDR=1

# La dirección IP del bridge se AUTO-DETECTA al iniciar (local_ip_address)
# y se usa para autenticación IP contra la tabla `bridges` del servidor.
# No se configura manualmente.

# Máximo de fallos consecutivos de conexión serial antes de
# detener el lector. Solo cuenta errores graves de conexión
# (puerto no disponible, I/O fatal). Los errores de lectura
# (timeout, CRC, parse) son informativos y nunca detienen
# el bridge. Por defecto: 10
SERIAL_MAX_FAILURES=10

# Timeout en segundos para cada operación de lectura serial.
# Por defecto: 3
BRIDGE_TIMEOUT_SECS=3

# ═══════════════════════════════════════════════════════════
#  Modo desarrollador.
#  Activa tracing detallado (debug) con salida a consola y
#  archivos rotativos diarios en logs/bridge.log.
# ═══════════════════════════════════════════════════════════
#
# Valores: true, 1, yes para activar. Cualquier otro valor
# o ausencia de la variable = modo producción.
BRIDGE_DEVELOPER_MODE=false


