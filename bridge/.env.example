# =============================================================================
#  omni-pdms-v2 — Variables de entorno del Bridge (referencia)
# =============================================================================
#
#  Copiar este archivo a .env en el mismo directorio y ajustar los valores.
#  El bridge es la pasarela serial -> WebSocket entre el dispositivo OMNI
#  y el servidor. Se ejecuta como proceso nativo (NO va en Docker).
#
#  Precedencia (de menor a mayor prioridad):
#    Valores por defecto -> .env -> variables de entorno -> CLI
#
#  NOTA: este .env es del BRIDGE. Las variables del servidor (DB_*, JWT_SECRET,
#  ADMIN_PASSWORD, etc.) viven en el .env raíz del proyecto.
#
# -----------------------------------------------------------------------------
#  Puerto serial
# -----------------------------------------------------------------------------
# Puerto donde está conectado el dispositivo OMNI.
# Ejemplos: COM1 (Windows), /dev/ttyUSB0 (Linux), /dev/cu.usbserial (macOS)
BRIDGE_PORT=COM1

# Velocidad de baudios para la comunicación serial.
# Valores típicos: 9600, 19200, 38400, 57600, 115200
BRIDGE_BAUD=115200

# URL del servidor WebSocket al que el bridge enviará los datos.
# Ejemplo: ws://host:9001/ws/bridge
BRIDGE_WS_URL=ws://localhost:9001/ws/bridge

# -----------------------------------------------------------------------------
#  Filtro de señales
# -----------------------------------------------------------------------------
# Solo las señales listadas en CAPTURE_NAMES se envían como telemetría
# (Readings) al servidor. CAPTURE_METADATA_NAMES se extraen para TherapySetup
# pero nunca se persisten.
#
# Si una variable está vacía o ausente, se usan los valores por defecto del
# código.
CAPTURE_NAMES=c_press_ep_act,c_pump_bs_bl_flow_act,c_pump_fs_mid_flow_act,d_renal_dose_act,c_acc_therapy_time_act,c_net_rem_flow_act,c_acc_net_rem_vol_act,c_press_ap_act,c_press_vp_act,c_press_fp_act,c_press_tmp_act
CAPTURE_METADATA_NAMES=d_serial_number_to_odi,g_patient_id_str,g_therapy_mode_set,g_anticoag_mode_set,d_kit_type_str,g_patient_data_weight_set

# -----------------------------------------------------------------------------
#  Protocolo OMNI-ODI
# -----------------------------------------------------------------------------
# Solo modificar si se tiene el conocimiento necesario.

# Intervalo entre ciclos de lectura serial en milisegundos.
# Mínimo práctico 1000 (1 s) por diseño del protocolo. Default: 1000.
BRIDGE_CYCLE_INTERVAL=1000

# Dirección de origen (aplicación bridge) en el bus OMNI-ODI. Rango 1-254.
# Por defecto: 11
BRIDGE_SRC_ADDR=11

# Dirección de destino (dispositivo) en el bus OMNI-ODI. Rango 1-254.
# Por defecto: 1
BRIDGE_DST_ADDR=1

# La IP del bridge se AUTO-DETECTA al iniciar y se usa para autenticación
# contra la tabla `bridges` del servidor. No se configura manualmente.

# Máximo de fallos consecutivos de conexión serial antes de detener el lector.
# Solo cuenta errores graves de conexión (puerto no disponible, I/O fatal).
# Los errores de lectura (timeout, CRC, parse) son informativos. Default: 10.
SERIAL_MAX_FAILURES=10

# Timeout en segundos para cada operación de lectura serial. Default: 3.
BRIDGE_TIMEOUT_SECS=3

# -----------------------------------------------------------------------------
#  Modo desarrollador
# -----------------------------------------------------------------------------
# Activa tracing detallado (debug) a consola y archivos rotativos en
# logs/bridge.log. Valores: true, 1, yes para activar. Cualquier otro valor
# o ausencia = modo producción.
BRIDGE_DEVELOPER_MODE=false
