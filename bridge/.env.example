# ──────────────────────────────────────────────────────────────
#  Configuración del Bridge OMNI-PDMS
# ──────────────────────────────────────────────────────────────
# Este archivo define los valores por defecto para el bridge
# (pasarela serial → WebSocket). Los valores aquí definidos
# pueden ser sobrescritos por variables de entorno del sistema
# y por argumentos de línea de comandos.
#
# Precedencia (de menor a mayor prioridad):
#   Valores por defecto → .env → variables de entorno → CLI
#
# Para usar este archivo, cópielo como .env en este mismo
# directorio y ajuste los valores según su instalación.
# ──────────────────────────────────────────────────────────────

# Puerto serial donde está conectado el dispositivo OMNI.
# Ejemplos: COM1 (Windows), /dev/ttyUSB0 (Linux), /dev/cu.usbserial (macOS)
BRIDGE_PORT=COM1

# Velocidad de baudios para la comunicación serial.
# Valores típicos: 9600, 19200, 38400, 57600, 115200
BRIDGE_BAUD=115200

# URL del servidor WebSocket al que el bridge enviará los datos.
# Ejemplo: ws://192.168.1.100:9000/ws
BRIDGE_WS_URL=ws://localhost:9000/ws

# ═══════════════════════════════════════════════════════════
#  Configuración de Protocolo OMNI-ODI.
#  Solo modificar si tiene los conocimientos necesarios.
# ═══════════════════════════════════════════════════════════

# Dirección de origen (aplicación bridge) en el bus OMNI-ODI.
# Rango típico: 1–254. Por defecto: 11
BRIDGE_SRC_ADDR=11

# Dirección de destino (dispositivo) en el bus OMNI-ODI.
# Rango típico: 1–254. Por defecto: 16
BRIDGE_DST_ADDR=1

# Dirección IP del bridge para autenticación contra el servidor.
# El servidor valida esta IP contra la tabla `bridges` al registrarse.
# Ejemplo: 10.0.0.50, 192.168.1.50
BRIDGE_IP=

# Máximo de fallos consecutivos de lectura serial antes de
# reiniciar el ciclo de comunicación. Por defecto: 10
BRIDGE_MAX_FAILURES=10

# Timeout en segundos para cada operación de lectura serial.
# Por defecto: 3
BRIDGE_TIMEOUT_SECS=3


