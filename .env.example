# =============================================================================
#  omni-pdms-v2 — Environment variables (production reference)
# =============================================================================
#
#  Copy this file to .env and adjust values for your environment.
#  Required variables without defaults will crash the server if missing.
#
#  Usage:
#    cp .env.example .env   (Linux/macOS)
#    copy .env.example .env  (Windows)

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=omni_pdms
DB_USERNAME=omni_user
DB_PASSWORD=<change-this>

# ── Server ───────────────────────────────────────────────────────────────────
PORT=9001

# ── Authentication (REQUIRED — no defaults) ─────────────────────────────────
JWT_SECRET=<generate-a-random-64-char-string>
ADMIN_PASSWORD=<set-a-strong-admin-password>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to the server's own origin (e.g. http://your-server:9001).
# Use * only for development.
CORS_ORIGINS=http://localhost:9001

# ── Frontend ─────────────────────────────────────────────────────────────────
# Path to the compiled SPA (Vite build output).
# When using docker-compose, mount the dist directory at this path.
FRONTEND_DIST=/app/frontend/dist

# ── Seed data ────────────────────────────────────────────────────────────────
# Language for auto-generated descriptions (es | en)
SEED_LANG=es

# Set to true to re-apply seed data on each restart (dev only)
SEED_REFRESH=false

# ── Persistence ────────────────────────────────────────────────────────────────
# Interval in seconds between batch persistence of readings to DB.
# Readings accumulate in memory and flush to DB every N seconds.
# Default: 30. Set to 0 for immediate persistence (every cycle).
PERSISTENCE_INTERVAL_SECS=30
