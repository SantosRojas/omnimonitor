# =============================================================================
#  omni-pdms-v2 — Environment variables (production reference)
# =============================================================================
#
#  Copy this file to .env and adjust values for your environment.
#  Required variables without defaults will crash the server if missing.
#
#  Usage:
#    cp .env.example .env   (Linux/macOS)
#    copy .env.example .env  (Windows)

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=omni_pdms
DB_USERNAME=omni_user
DB_PASSWORD=<change-this>

# ── Server ───────────────────────────────────────────────────────────────────
PORT=9001

# ── Authentication (REQUIRED — no defaults) ─────────────────────────────────
JWT_SECRET=<generate-a-random-64-char-string>
ADMIN_PASSWORD=<set-a-strong-admin-password>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to the server's own origin (e.g. http://your-server:9001).
# Use * only for development.
CORS_ORIGINS=http://localhost:9001

# ── Frontend ─────────────────────────────────────────────────────────────────
# Path to the compiled SPA (Vite build output). Inside the Docker/Podman
# image the frontend is built and placed at /app/frontend/dist automatically.
# Only override for native (non-container) deployments.
FRONTEND_DIST=/app/frontend/dist

# ── Seed data ────────────────────────────────────────────────────────────────
# Language for auto-generated descriptions (es | en)
SEED_LANG=es

# Set to true to re-apply seed data on each restart (dev only)
SEED_REFRESH=false

# ── Persistence ────────────────────────────────────────────────────────────────
# Interval in seconds between batch persistence of readings to DB.
# Readings accumulate in memory and flush to DB every N seconds.
# Default: 30. Set to 0 for immediate persistence (every cycle).
PERSISTENCE_INTERVAL_SECS=30

# ── Bridge capture filter ──────────────────────────────────────────────────────
# The bridge filters signals before sending to the server.
# CAPTURE_NAMES: telemetry signals persisted as readings.
# CAPTURE_METADATA_NAMES: therapy/identification signals sent as TherapySetup
# (never persisted). When empty or unset, bridge defaults apply.
CAPTURE_NAMES=c_press_ep_act,c_pump_bs_bl_flow_act,c_pump_fs_mid_flow_act,d_renal_dose_act,c_acc_therapy_time_act,c_net_rem_flow_act,c_acc_net_rem_vol_act,c_press_ap_act,c_press_vp_act,c_press_fp_act,c_press_tmp_act
CAPTURE_METADATA_NAMES=d_serial_number_to_odi,g_patient_id_str,g_therapy_mode_set,g_anticoag_mode_set,d_kit_type_str,g_patient_data_weight_set
