# =============================================================================
#  omni-pdms-v2 — Variables de entorno del servidor (referencia)
# =============================================================================
#
#  Copiar este archivo a .env y ajustar los valores.
#  Las variables marcadas REQUERIDA detienen el arranque si faltan.
#
#  Uso:
#    cp .env.example .env        (Linux/macOS)
#    copy .env.example .env      (Windows)
#
#  NOTA: este .env es del SERVIDOR. Las variables del bridge (CAPTURE_NAMES,
#  BRIDGE_*, SERIAL_*) viven en bridge/.env.example, no aquí.
#
# -----------------------------------------------------------------------------
#  Base de datos
# -----------------------------------------------------------------------------
# Con Docker/Podman: dejar DB_HOST=postgres (nombre del servicio compose).
# Despliegue nativo (sin Docker): cambiar a DB_HOST=localhost.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=omni_pdms
DB_USERNAME=omni_user
DB_PASSWORD=<change-this>

# -----------------------------------------------------------------------------
#  Servidor
# -----------------------------------------------------------------------------
PORT=9001

# -----------------------------------------------------------------------------
#  Autenticación (REQUERIDAS — no tienen valor por defecto)
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 32
JWT_SECRET=<generate-a-random-64-char-string>
ADMIN_PASSWORD=<set-a-strong-admin-password>

# -----------------------------------------------------------------------------
#  CORS
# -----------------------------------------------------------------------------
# Orígenes permitidos separados por coma. En producción usar el origen real
# (p. ej. https://hospital.pdms.example.com). Usar * solo en desarrollo.
CORS_ORIGINS=http://localhost:9001

# -----------------------------------------------------------------------------
#  Frontend compilado (solo despliegue nativo)
# -----------------------------------------------------------------------------
# Dentro de la imagen Docker/Podman el frontend ya está en /app/frontend/dist;
# NO tocar esta variable para contenedores.
# Despliegue nativo: FRONTEND_DIST=frontend/dist (relativo al WorkingDirectory).
FRONTEND_DIST=/app/frontend/dist

# -----------------------------------------------------------------------------
#  Seed de datos
# -----------------------------------------------------------------------------
# Idioma de las descripciones generadas (es | en)
SEED_LANG=es

# true re-aplica el seed en cada reinicio (solo desarrollo)
SEED_REFRESH=false

# -----------------------------------------------------------------------------
#  Persistencia
# -----------------------------------------------------------------------------
# Intervalo en segundos entre flushes de lecturas a la base de datos.
# 0 = persistencia inmediata (cada ciclo). Default: 30.
PERSISTENCE_INTERVAL_SECS=30
